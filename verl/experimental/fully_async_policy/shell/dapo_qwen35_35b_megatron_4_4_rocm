#!/usr/bin/env bash
set -xeuo pipefail

# ==============================================================================
# Paths and experiment
# ==============================================================================

RAY_DATA_HOME=${RAY_DATA_HOME:-"${HOME}/verl"}

project_name=${PROJECT_NAME:-"verl_dapo_math_17k_qwen3_5_35b"}
exp_name=${EXP_NAME:-"qwen3_5_35b_megatron_fully_async_4_4"}

MODEL_PATH=${MODEL_PATH:-"${RAY_DATA_HOME}/models/Qwen3.5-35B-A3B"}
CKPTS_DIR=${CKPTS_DIR:-"${RAY_DATA_HOME}/ckpts/${project_name}/${exp_name}"}

TRAIN_FILE=${TRAIN_FILE:-"${RAY_DATA_HOME}/data/dapo-math-17k.parquet"}
TEST_FILE=${TEST_FILE:-"${RAY_DATA_HOME}/data/aime-2024.parquet"}

# ==============================================================================
# Rollout backend
# ==============================================================================

rollout_mode=${ROLLOUT_MODE:-"async"}
rollout_name=${ROLLOUT_NAME:-"vllm"}

return_raw_chat=True

if [[ "${rollout_mode}" == "async" && "${rollout_name}" == "vllm" ]]; then
    export VLLM_USE_V1=1
fi

# ==============================================================================
# Algorithm
# ==============================================================================

adv_estimator=grpo

use_kl_in_reward=False
kl_coef=0.0

use_kl_loss=False
kl_loss_coef=0.0
kl_loss_type=low_var_kl

clip_ratio_low=0.2
clip_ratio_high=0.28
clip_ratio_c=10.0

loss_agg_mode="token-mean"

# ==============================================================================
# Sequence lengths
# ==============================================================================

max_prompt_length=$((1024 * 2))
max_response_length=$((1024 * 8))
max_model_length=$((max_prompt_length + max_response_length))

# DAPO overlong reward shaping
enable_overlong_buffer=True
overlong_buffer_len=$((1024 * 4))
overlong_penalty_factor=1.0

# ==============================================================================
# Sampling
# ==============================================================================

temperature=1.0
top_p=1.0
top_k=-1

# Follow the DAPO recipe and use sampled validation.
val_temperature=1.0
val_top_p=0.7
val_top_k=-1
val_do_sample=True

n_resp_per_prompt=16

# ==============================================================================
# Training batch configuration
# ==============================================================================

# Qwen3.5 GDN uses BSHD:
# - use_remove_padding=False
# - use_dynamic_bsz=False
use_dynamic_bsz=False

# Fully async requires data.train_batch_size=0 and data.gen_batch_size=1.
train_prompt_bsz=0
gen_prompt_bsz=1

train_prompt_mini_bsz=32

# Required when use_dynamic_bsz=False.
train_ppo_micro_batch_size_per_gpu=${TRAIN_PPO_MICRO_BATCH_SIZE_PER_GPU:-1}
infer_ppo_micro_batch_size_per_gpu=${INFER_PPO_MICRO_BATCH_SIZE_PER_GPU:-1}

# ==============================================================================
# Megatron parallelism: 4 training GPUs
# ==============================================================================

train_tp=${TRAIN_TP:-2}
train_ep=${TRAIN_EP:-4}
train_pp=${TRAIN_PP:-1}
train_etp=${TRAIN_ETP:-1}

USE_MBRIDGE=${USE_MBRIDGE:-True}
VANILLA_MBRIDGE=${VANILLA_MBRIDGE:-False}

MEGATRON_ATTN_BACKEND=${MEGATRON_ATTN_BACKEND:-auto}

# Router load-balancing loss.
MOE_AUX_LOSS_COEFF=${MOE_AUX_LOSS_COEFF:-0.001}

# ==============================================================================
# Rollout parallelism: 4 rollout GPUs
# ==============================================================================

gen_tp=${GEN_TP:-4}
rollout_gpu_memory_utilization=${ROLLOUT_GPU_MEMORY_UTILIZATION:-0.70}

# ==============================================================================
# Resources
# ==============================================================================

NNODES_TRAIN=${NNODES_TRAIN:-1}
N_GPUS_TRAIN=${N_GPUS_TRAIN:-4}

NNODES_ROLLOUT=${NNODES_ROLLOUT:-1}
N_GPUS_ROLLOUT=${N_GPUS_ROLLOUT:-4}

# ==============================================================================
# Fully async configuration
# ==============================================================================

total_rollout_steps=${TOTAL_ROLLOUT_STEPS:-$((512 * 100))}

staleness_threshold=${STALENESS_THRESHOLD:-0.5}
trigger_parameter_sync_step=${TRIGGER_PARAMETER_SYNC_STEP:-4}
require_batches=${REQUIRE_BATCHES:-4}
partial_rollout=${PARTIAL_ROLLOUT:-True}

# With the defaults:
#
# required_samples
#   = ppo_mini_batch_size * require_batches
#   = 32 * 4
#   = 128 trajectories
#
# total training steps
#   = total_rollout_steps /
#     (required_samples * trigger_parameter_sync_step)
#   = 51200 / (128 * 4)
#   = 100

# ==============================================================================
# Trainer configuration
# ==============================================================================

total_epochs=${TOTAL_EPOCHS:-10}
test_freq=${TEST_FREQ:-10}
save_freq=${SAVE_FREQ:-10}
val_before_train=${VAL_BEFORE_TRAIN:-True}
resume_mode=${RESUME_MODE:-auto}

# ==============================================================================
# Environment
# ==============================================================================

export CUDA_DEVICE_MAX_CONNECTIONS=1
export VLLM_ALLREDUCE_USE_SYMM_MEM=0
export HYDRA_FULL_ERROR=1
export TOKENIZERS_PARALLELISM=false

# ==============================================================================
# Preflight checks
# ==============================================================================

if [[ ! -f "${TRAIN_FILE}" ]]; then
    echo "ERROR: training file does not exist: ${TRAIN_FILE}" >&2
    exit 1
fi

if [[ ! -f "${TEST_FILE}" ]]; then
    echo "ERROR: validation file does not exist: ${TEST_FILE}" >&2
    exit 1
fi

if (( N_GPUS_ROLLOUT % gen_tp != 0 )); then
    echo \
        "ERROR: N_GPUS_ROLLOUT=${N_GPUS_ROLLOUT} must be divisible by gen_tp=${gen_tp}" \
        >&2
    exit 1
fi

if (( N_GPUS_TRAIN % (train_tp * train_pp) != 0 )); then
    echo \
        "ERROR: N_GPUS_TRAIN=${N_GPUS_TRAIN} must be divisible by train_tp*train_pp=$((train_tp * train_pp))" \
        >&2
    exit 1
fi

if (( N_GPUS_TRAIN % train_ep != 0 )); then
    echo \
        "ERROR: N_GPUS_TRAIN=${N_GPUS_TRAIN} must be divisible by train_ep=${train_ep}" \
        >&2
    exit 1
fi

if (( train_ppo_micro_batch_size_per_gpu < 1 )); then
    echo "ERROR: TRAIN_PPO_MICRO_BATCH_SIZE_PER_GPU must be at least 1" >&2
    exit 1
fi

mkdir -p "${CKPTS_DIR}"

echo "============================================================"
echo "Project:                 ${project_name}"
echo "Experiment:              ${exp_name}"
echo "Model:                   ${MODEL_PATH}"
echo "Train data:              ${TRAIN_FILE}"
echo "Validation data:         ${TEST_FILE}"
echo "Checkpoint directory:    ${CKPTS_DIR}"
echo "Training GPUs:           ${NNODES_TRAIN} x ${N_GPUS_TRAIN}"
echo "Rollout GPUs:            ${NNODES_ROLLOUT} x ${N_GPUS_ROLLOUT}"
echo "Training TP/EP/PP/ETP:   ${train_tp}/${train_ep}/${train_pp}/${train_etp}"
echo "Rollout TP:              ${gen_tp}"
echo "Prompt/response length:  ${max_prompt_length}/${max_response_length}"
echo "Total rollout steps:     ${total_rollout_steps}"
echo "Staleness threshold:     ${staleness_threshold}"
echo "Parameter sync interval: ${trigger_parameter_sync_step}"
echo "Required batches:        ${require_batches}"
echo "============================================================"

# ==============================================================================
# Launch
# ==============================================================================

python -m verl.experimental.fully_async_policy.fully_async_main \
    --config-path=config \
    --config-name=fully_async_ppo_megatron_trainer \
    \
    algorithm.adv_estimator=${adv_estimator} \
    algorithm.use_kl_in_reward=${use_kl_in_reward} \
    algorithm.kl_ctrl.kl_coef=${kl_coef} \
    \
    data.train_files="${TRAIN_FILE}" \
    data.val_files="${TEST_FILE}" \
    data.prompt_key=prompt \
    data.train_batch_size=${train_prompt_bsz} \
    data.gen_batch_size=${gen_prompt_bsz} \
    data.max_prompt_length=${max_prompt_length} \
    data.max_response_length=${max_response_length} \
    data.filter_overlong_prompts=True \
    data.truncation=error \
    data.return_raw_chat=${return_raw_chat} \
    \
    actor_rollout_ref.model.path="${MODEL_PATH}" \
    actor_rollout_ref.model.trust_remote_code=True \
    actor_rollout_ref.model.use_remove_padding=False \
    \
    actor_rollout_ref.actor.ppo_mini_batch_size=${train_prompt_mini_bsz} \
    actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=${train_ppo_micro_batch_size_per_gpu} \
    actor_rollout_ref.actor.use_dynamic_bsz=${use_dynamic_bsz} \
    actor_rollout_ref.actor.loss_agg_mode=${loss_agg_mode} \
    actor_rollout_ref.actor.use_kl_loss=${use_kl_loss} \
    actor_rollout_ref.actor.kl_loss_coef=${kl_loss_coef} \
    actor_rollout_ref.actor.kl_loss_type=${kl_loss_type} \
    actor_rollout_ref.actor.clip_ratio_low=${clip_ratio_low} \
    actor_rollout_ref.actor.clip_ratio_high=${clip_ratio_high} \
    actor_rollout_ref.actor.clip_ratio_c=${clip_ratio_c} \
    actor_rollout_ref.actor.entropy_coeff=0 \
    \
    actor_rollout_ref.actor.optim.lr=1e-6 \
    actor_rollout_ref.actor.optim.lr_warmup_steps=10 \
    actor_rollout_ref.actor.optim.lr_decay_style=constant \
    actor_rollout_ref.actor.optim.weight_decay=0.1 \
    actor_rollout_ref.actor.optim.clip_grad=1.0 \
    \
    actor_rollout_ref.actor.megatron.tensor_model_parallel_size=${train_tp} \
    actor_rollout_ref.actor.megatron.expert_model_parallel_size=${train_ep} \
    actor_rollout_ref.actor.megatron.pipeline_model_parallel_size=${train_pp} \
    actor_rollout_ref.actor.megatron.expert_tensor_parallel_size=${train_etp} \
    actor_rollout_ref.actor.megatron.use_remove_padding=False \
    actor_rollout_ref.actor.megatron.param_offload=False \
    actor_rollout_ref.actor.megatron.optimizer_offload=False \
    actor_rollout_ref.actor.megatron.grad_offload=False \
    actor_rollout_ref.actor.megatron.use_mbridge=${USE_MBRIDGE} \
    actor_rollout_ref.actor.megatron.vanilla_mbridge=${VANILLA_MBRIDGE} \
    actor_rollout_ref.actor.megatron.dtype=bfloat16 \
    actor_rollout_ref.actor.megatron.override_transformer_config.attention_backend=${MEGATRON_ATTN_BACKEND} \
    actor_rollout_ref.actor.megatron.override_transformer_config.recompute_method=uniform \
    actor_rollout_ref.actor.megatron.override_transformer_config.recompute_granularity=full \
    actor_rollout_ref.actor.megatron.override_transformer_config.recompute_num_layers=1 \
    +actor_rollout_ref.actor.megatron.override_transformer_config.moe_aux_loss_coeff=${MOE_AUX_LOSS_COEFF} \
    +actor_rollout_ref.actor.megatron.override_transformer_config.moe_permute_fusion=True \
    +actor_rollout_ref.actor.megatron.override_transformer_config.moe_grouped_gemm=True \
    \
    actor_rollout_ref.rollout.name=${rollout_name} \
    actor_rollout_ref.rollout.mode=${rollout_mode} \
    actor_rollout_ref.rollout.n=${n_resp_per_prompt} \
    actor_rollout_ref.rollout.tensor_model_parallel_size=${gen_tp} \
    actor_rollout_ref.rollout.dtype=bfloat16 \
    actor_rollout_ref.rollout.gpu_memory_utilization=${rollout_gpu_memory_utilization} \
    actor_rollout_ref.rollout.max_model_len=${max_model_length} \
    actor_rollout_ref.rollout.max_num_batched_tokens=${max_model_length} \
    actor_rollout_ref.rollout.enable_chunked_prefill=True \
    actor_rollout_ref.rollout.temperature=${temperature} \
    actor_rollout_ref.rollout.top_p=${top_p} \
    actor_rollout_ref.rollout.top_k=${top_k} \
    actor_rollout_ref.rollout.val_kwargs.temperature=${val_temperature} \
    actor_rollout_ref.rollout.val_kwargs.top_p=${val_top_p} \
    actor_rollout_ref.rollout.val_kwargs.top_k=${val_top_k} \
    actor_rollout_ref.rollout.val_kwargs.do_sample=${val_do_sample} \
    actor_rollout_ref.rollout.val_kwargs.n=1 \
    actor_rollout_ref.rollout.calculate_log_probs=True \
    actor_rollout_ref.rollout.log_prob_use_dynamic_bsz=False \
    actor_rollout_ref.rollout.log_prob_micro_batch_size_per_gpu=${infer_ppo_micro_batch_size_per_gpu} \
    actor_rollout_ref.rollout.checkpoint_engine.backend=nccl \
    \
    reward.reward_manager.name=dapo \
    +reward.reward_kwargs.overlong_buffer_cfg.enable=${enable_overlong_buffer} \
    +reward.reward_kwargs.overlong_buffer_cfg.len=${overlong_buffer_len} \
    +reward.reward_kwargs.overlong_buffer_cfg.penalty_factor=${overlong_penalty_factor} \
    +reward.reward_kwargs.overlong_buffer_cfg.log=False \
    +reward.reward_kwargs.max_resp_len=${max_response_length} \
    \
    actor_rollout_ref.hybrid_engine=False \
    \
    trainer.logger="['console','wandb']" \
    trainer.project_name="${project_name}" \
    trainer.experiment_name="${exp_name}" \
    trainer.nnodes=${NNODES_TRAIN} \
    trainer.n_gpus_per_node=${N_GPUS_TRAIN} \
    trainer.default_local_dir="${CKPTS_DIR}" \
    trainer.resume_mode=${resume_mode} \
    trainer.save_freq=${save_freq} \
    trainer.val_before_train=${val_before_train} \
    trainer.test_freq=${test_freq} \
    trainer.total_epochs=${total_epochs} \
    \
    rollout.nnodes=${NNODES_ROLLOUT} \
    rollout.n_gpus_per_node=${N_GPUS_ROLLOUT} \
    rollout.total_rollout_steps=${total_rollout_steps} \
    \
    async_training.staleness_threshold=${staleness_threshold} \
    async_training.trigger_parameter_sync_step=${trigger_parameter_sync_step} \
    async_training.require_batches=${require_batches} \
    async_training.partial_rollout=${partial_rollout}
